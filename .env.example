# Скопируйте в .env и заполните. Файл .env в репозиторий не кладётся.

# https://my.telegram.org → API development tools
API_ID=
API_HASH=
# Аккаунт, который состоит в закрытой группе. Международный формат.
PHONE=+79991234567
# Пароль облачного 2FA. Нужен только если он включён на аккаунте.
# TG_2FA_PASSWORD=

# Id супергруппы, обычно начинается с -100.
TG_CHAT_ID=-1001234567890
# Числовые id кураторов через запятую, без пробелов вокруг не обязательны.
ALLOWED_TG_USER_IDS=111222333,444555666

# Ключ сообщества с правами: стена, фотографии, документы, видео, сообщества.
VK_TOKEN=
# Id сообщества БЕЗ минуса. Минус подставляется в owner_id стены автоматически.
VK_GROUP_ID=123456789

# Необязательно.
# SESSION_DIR=sessions
# LOG_LEVEL=INFO
# Сколько секунд тишины ждать, чтобы собрать альбом Telegram в один пост ВК.
# ALBUM_QUIET_SECONDS=2.5
# Крайний срок ожидания альбома, даже если части всё ещё приходят.
# ALBUM_MAX_WAIT_SECONDS=12
